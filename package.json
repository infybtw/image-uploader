{
  "name": "imageuploader",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run build:firefox && bun run build:chrome && bun run build:userscript",
    "build:firefox": "bun --bun x wxt build -b firefox",
    "build:chrome": "bun --bun x wxt build -b chrome",
    "build:userscript": "bun scripts/build-userscript.ts",
    "release:check": "bun scripts/check-release.ts",
    "postinstall": "bun --bun x wxt prepare",
    "test": "bun test",
    "test:firefox": "bun scripts/test-browser.ts firefox",
    "test:chrome": "bun scripts/test-browser.ts chrome",
    "typecheck": "bun --bun x wxt prepare && bun check",
    "lint": "bun fmt --check",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "package": "bun run package:firefox && bun run package:chrome",
    "package:firefox": "bun --bun x wxt zip -b firefox",
    "package:chrome": "bun --bun x wxt zip -b chrome"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "fflate": "0.8.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "lucide": "1.61.0",
    "morphicons": "2.0.2"
  }
}
